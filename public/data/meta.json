 "epilogues": {
  "edric": [
   {
    "label": "文书有效且路线安全",
    "text": "母亲、莉莉与艾德里克在三天后乘货车南下。母亲一路抱怨票据兑换价，说明她并未因被救变成温柔的象征。",
    "cond": {
     "flag": "harlan_writ"
    }
   },
   {
    "label": "以父亲记忆为代价",
    "text": "他知道父亲存在，知道其死亡，却再也想不起脸和声音。莉莉描述时，他只能依照她的版本重新认识那个人。木梳仍让他感到重要，但说不出原因。",
    "cond": {
     "flag": "lost_father_memory"
    }
   },
   {
    "label": "父亲军信公开",
    "text": "帝国承认小队并非逃兵，却把责任推给已死副尉。母亲把更正告示折好垫桌脚：“它来晚了，至少纸还平。”",
    "cond": {
     "all": [
      {
       "flag": "truth_public"
      },
      {
       "flag": "father_letter_kept"
      }
     ]
    }
   },
   {
    "label": "私人目标放弃",
    "text": "他仍需挣钱、照顾病人，并面对自己主动放弃的那张车票。",
    "cond": {
     "else": true
    }
   }
  ],
  "liriel": [
   {
    "label": "完整证据与活证人公开",
    "text": "苔冠案引发听证。科尔认罪，赛拉最初合作与后来反悔也被记录在案。部分精灵指责莉瑞尔让母亲蒙羞，部分人感谢她没有只公布对家族有利的部分。她没有被全体原谅，但不再由秘密独自定义。",
    "cond": {
     "cmp": [
      "truth",
      ">=",
      4
     ]
    }
   },
   {
    "label": "焚毁档案",
    "text": "档案化为灰烬，罪行与责任也难以追究。她保留家庭账簿中一页普通盐账，决定记住家人生活过，不只记住他们被怎样杀死。",
    "cond": {
     "flag": "private_goal_abandoned"
    }
   },
   {
    "label": "高腐化",
    "text": "即使脱离塞维兰，她仍很容易把被需要当作爱。米拉可成为边界导师；若米拉敌对，莉瑞尔独自学习。",
    "cond": {
     "cmp": [
      "corruption",
      ">=",
      3
     ]
    }
   },
   {
    "label": "选择性证据",
    "text": "帝国罪行仍曝光，莉瑞尔暂时成为幸存者象征。只有凯尔或布兰知道删掉的句子。每次有人称她“苔冠最后的勇者”，银链已经不在，她仍会本能地想躲开目光。",
    "cond": {
     "else": true
    }
   }
  ],
  "thorin": [
   {
    "label": "合法交货或免责",
    "text": "家族保住工坊。父亲第一封信只问印章，第二封才问索林是否受伤。索林可回家接订单，也可拒绝帝国长期合同。",
    "cond": {
     "any": [
      {
       "flag": "private_goal_secured"
      },
      {
       "flag": "workshop_ledger"
      }
     ]
    }
   },
   {
    "label": "假印成功",
    "text": "钱到账，哈兰或军需官保留把柄。每一批新订单都比上一批更接近武器。",
    "cond": {
     "flag": "harlan_blackmail"
    }
   },
   {
    "label": "怀表内化",
    "text": "每次发怒，胸口都会响一声。索林学会先告诉身边人“我现在听见了”，不把症状当免除责任的借口。",
    "cond": {
     "ending": "END-CURE-04"
    }
   },
   {
    "label": "放弃订单救矿工",
    "text": "父亲起初写了三页责骂，随后赫尔嘉匿名买下积压工具。",
    "cond": {
     "else": true
    }
   }
  ]
 },
